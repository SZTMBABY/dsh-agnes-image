{
  "name": "dsh-agnes-image",
  "version": "1.4.1",
  "description": "Agnes image and video generation for DeepSeek Harness: two agent tools, an AI prompt optimizer, and a sidebar panel whose API key is entered in the panel and never shipped in the code.",
  "license": "MIT",
  "author": "SZTMBABY",
  "type": "module",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "agnes",
    "image-generation",
    "video-generation",
    "ai"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README_ZH.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "screenshots"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SZTMBABY/dsh-agnes-image.git"
  },
  "homepage": "https://github.com/SZTMBABY/dsh-agnes-image#readme",
  "bugs": {
    "url": "https://github.com/SZTMBABY/dsh-agnes-image/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
